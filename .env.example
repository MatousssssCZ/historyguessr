# ─── HistoryGuessr · proměnné prostředí ───────────────────
# Zkopíruj do .env.local a vyplň podle prostředí, ve kterém běžíš.
# .env.local je v .gitignore (necommituje se).

# ── LOKÁLNÍ VÝVOJ (Path A: `supabase start` v Dockeru) ─────
# Přesné hodnoty vypíše `supabase status` po `supabase start`.
# Lokální anon key je fixní demo JWT (stejný na všech strojích).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Označení prostředí → řídí LOCAL/TEST odznak v appce.
# Hodnoty: local | test | production
VITE_APP_ENV=local

# Sentry (sledování chyb) — nepovinné. Bez DSN je Sentry vypnutý.
# DSN najdeš v Sentry projektu; na produkci patří do Vercel env.
# VITE_SENTRY_DSN=https://xxxx@xxxx.ingest.sentry.io/xxxx

# AdSense — nepovinné. Bez VITE_ADSENSE_CLIENT jsou reklamy VYPNUTÉ všude.
# Vyplň až PO schválení AdSense (patří jen do Vercel Production env).
# VITE_ADSENSE_CLIENT=ca-pub-0000000000000000
# VITE_ADSENSE_SLOT_OVERVIEW=0000000000
# VITE_ADSENSE_SLOT_AFTER_GAME=0000000000
# VITE_ADSENSE_SLOT_AFTER_CAMPAIGN=0000000000
# VITE_ADSENSE_SLOT_BEFORE_NEXT=0000000000

# ── PRODUKCE ──────────────────────────────────────────────
# Produkční hodnoty NEDÁVEJ sem ani do repa — patří jen do
# Vercel → Settings → Environment Variables (scope Production):
#   VITE_SUPABASE_URL=https://wgiijdnoiiuxxucacyio.supabase.co
#   VITE_SUPABASE_ANON_KEY=<prod anon key>
#   VITE_APP_ENV=production
